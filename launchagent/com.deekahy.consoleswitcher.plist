<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.deekahy.consoleswitcher</string>

    <key>ProgramArguments</key>
    <array>
        <!-- Must be the binary inside the .app bundle, not a bare copy
             elsewhere — see the README for why that matters here. Adjust
             this path if you installed the app somewhere other than
             /Applications. -->
        <string>/Applications/ConsoleSwitcher.app/Contents/MacOS/ConsoleSwitcher</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/consoleswitcher.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/consoleswitcher.log</string>
</dict>
</plist>
